// Copy this file to Secrets.xcconfig (same directory) and fill in the values.
// Secrets.xcconfig is git-ignored so real credentials never reach source control.
//
// APPMETRICA_API_KEY: API key from AppMetrica → Settings → Main. Leave empty
// to disable analytics for local builds.
// BACKEND_BASE_URL: Fully qualified https URL of the production backend,
// including the /api suffix. Leave empty to force the client into offline
// (bundled catalog) mode.

APPMETRICA_API_KEY =
BACKEND_BASE_URL =

// DEBUG dev-auth is intentionally supplied through Scheme Environment
// Variables so it cannot be embedded in a Release Info.plist:
// DEV_AUTH_ENABLED = 1
// DEV_AUTH_SECRET = <local backend secret>
// API_BASE_URL = http://localhost:8000/api
